# Copier ce fichier en .env et renseigner vos valeurs
# Le fichier .env est gitignore — ne jamais le commiter
#
# SNOWFLAKE_PASSWORD = votre mot de passe Snowflake
# dans snowflake/00_setup.sql (même valeur, stockée ici pour usage local)

SNOWFLAKE_ACCOUNT=<identifiant-compte>
SNOWFLAKE_USER=<votre-username-snowflake>   # Ashley, Matthieu, Lounes
SNOWFLAKE_PASSWORD=<votre-mot-de-passe>
DBT_USER=<VOTRE_PRENOM_EN_MAJUSCULES>       # schéma dev dbt : DBT_LOUNES, DBT_ASHLEY...

# dbt lit profiles.yml depuis dbt_nyc_taxi/ — ne pas modifier
DBT_PROFILES_DIR=.
